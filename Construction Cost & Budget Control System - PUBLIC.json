      "name": "Retrieve Cost Transactions"
    },
    {
      "parameters": {
        "jsCode": "// Read data from both previous nodes\nconst budgets = $('Retrieve Project Budgets').all().map(item => item.json);\nconst transactions = $('Retrieve Cost Transactions').all().map(item => item.json);\n\n// Group transactions by Project ID + Cost Category\nconst groupedTransactions = {};\n\nfor (const tx of transactions) {\n  const key = `${tx['Project ID']}||${tx['Cost Category']}`;\n\n  if (!groupedTransactions[key]) {\n    groupedTransactions[key] = {\n      actual: 0,\n      committed: 0,\n    };\n  }\n\n  const amount = Number(tx['Amount']) || 0;\n  const costType = String(tx['Cost Type'] || '').trim().toLowerCase();\n\n  if (costType === 'actual') {\n    groupedTransactions[key].actual += amount;\n  }\n\n  if (costType === 'committed') {\n    groupedTransactions[key].committed += amount;\n  }\n}\n\n// Build one result row for every budget line\nconst results = budgets.map(budgetRow => {\n  const projectId = budgetRow['Project ID'];\n  const projectName = budgetRow['Project Name'];\n  const costCategory = budgetRow['Cost Category'];\n  const budget = Number(budgetRow['Budget']) || 0;\n\n  const key = `${projectId}||${costCategory}`;\n\n  const actualCost = groupedTransactions[key]?.actual || 0;\n  const committedCost = groupedTransactions[key]?.committed || 0;\n\n  const forecastCost = actualCost + committedCost;\n  const variance = budget - forecastCost;\n  const budgetUsedPercent =\n    budget > 0 ? (actualCost / budget) * 100 : 0;\n\n  let status = 'NORMAL';\n\n  if (forecastCost > budget) {\n    status = 'OVERRUN';\n  } else if (budgetUsedPercent >= 95) {\n    status = 'CRITICAL';\n  } else if (budgetUsedPercent >= 80) {\n    status = 'WARNING';\n  }\n\n  return {\n    json: {\n      'Budget Key': `${projectId}|${costCategory}`,\n      'Project ID': projectId,\n      'Project Name': projectName,\n      'Cost Category': costCategory,\n      'Budget': budget,\n      'Actual Cost': actualCost,\n      'Committed Cost': committedCost,\n      'Forecast Cost': forecastCost,\n      'Variance': variance,\n      'Budget Used %': Number(budgetUsedPercent.toFixed(2)),\n      'Status': status,\n    }\n  };\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
