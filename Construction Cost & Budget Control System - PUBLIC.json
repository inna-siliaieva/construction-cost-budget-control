    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst counts = {\n  NORMAL: 0,\n  WARNING: 0,\n  CRITICAL: 0,\n  OVERRUN: 0,\n};\n\nfor (const item of items) {\n  const status = item['Status'];\n  if (counts[status] !== undefined) {\n    counts[status]++;\n  }\n}\n\nconst problemItems = items.filter(item =>\n  ['WARNING', 'CRITICAL', 'OVERRUN'].includes(item['Status'])\n);\n\nlet message = `📊 DAILY BUDGET CONTROL SUMMARY\n\nProjects / categories checked: ${items.length}\n\n✅ Normal: ${counts.NORMAL}\n⚠️ Warning: ${counts.WARNING}\n🔴 Critical: ${counts.CRITICAL}\n🚨 Overrun: ${counts.OVERRUN}\n\n`;\n\nif (problemItems.length === 0) {\n  message += `No budget issues require attention.`;\n} else {\n  message += `ISSUES REQUIRING ATTENTION:\\n\\n`;\n\n  for (const item of problemItems) {\n    message += `${item['Project ID']} — ${item['Project Name']}\nCategory: ${item['Cost Category']}\nStatus: ${item['Status']}\nBudget: €${item['Budget']}\nActual Cost: €${item['Actual Cost']}\nCommitted Cost: €${item['Committed Cost']}\nForecast Cost: €${item['Forecast Cost']}\nBudget Used: ${item['Budget Used %']}%\nVariance: €${item['Variance']}\n\n`;\n  }\n}\n\nreturn [\n  {\n    json: {\n      Message: message,\n      TotalChecked: items.length,\n      NormalCount: counts.NORMAL,\n      WarningCount: counts.WARNING,\n      CriticalCount: counts.CRITICAL,\n      OverrunCount: counts.OVERRUN,\n      IssuesCount: problemItems.length,\n    }\n  }\n];"
      },
